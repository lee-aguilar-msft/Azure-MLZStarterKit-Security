{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "MLZ Security Lab: (re)apply the LAB-SecurityCollectionGroup firewall rules to the hub firewall policy. Deploy to the hub resource group."
  },
  "parameters": {
    "firewallPolicyName": {
      "type": "string",
      "metadata": {
        "description": "Name of the MLZ hub firewall policy (Microsoft.Network/firewallPolicies) in this resource group."
      }
    },
    "virtualNetworkAddressPrefix": {
      "type": "string",
      "defaultValue": "10.60.0.0/24",
      "metadata": {
        "description": "Address prefix of the lab (Tier 3) virtual network - the source of the lab rules."
      }
    },
    "allowAllAzureServiceTags": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Include the AzureCloud catch-all network rule collection."
      }
    }
  },

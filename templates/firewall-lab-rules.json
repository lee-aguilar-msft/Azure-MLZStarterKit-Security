            "ipProtocols": [
              "TCP"
            ],
            "sourceAddresses": [
              "[parameters('virtualNetworkAddressPrefix')]"
            ],
            "sourceIpGroups": [],
            "destinationPorts": [
              "443"
            ],
            "destinationIpGroups": [],
            "destinationAddresses": [

    "workloadShortName": { "value": "lab" },
    "prefix": { "value": "sdl" },
    "cloudSuffix": { "value": "us" },
    "virtualNetworkAddressPrefix": { "value": "10.60.0.0/24" },
    "subnetAddressPrefix": { "value": "10.60.0.0/25" },
    "domainControllerPrivateIp": { "value": "10.60.0.10" },
    "adminUsername": { "value": "labadmin" },
    "adminPassword": { "value": "" },
    "safeModeAdminPassword": { "value": "" },
    "domainName": { "value": "corp.sleepingdragonslab.us" },
    "domainNetbiosName": { "value": "CORP" },

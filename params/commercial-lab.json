{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "metadata": { "comment": "Azure Commercial lab. Deploy at subscription scope in portal.azure.com or `az deployment sub create`. Secrets blank — supply at deploy time." },
  "parameters": {
    "location": { "value": "eastus" },
    "identifier": { "value": "lab" },
    "environmentAbbreviation": { "value": "dev" },
    "workloadName": { "value": "seclab" },
    "workloadShortName": { "value": "lab" },
    "prefix": { "value": "lab" },
    "cloudSuffix": { "value": "com" },
    "virtualNetworkAddressPrefix": { "value": "10.20.0.0/24" },
    "subnetAddressPrefix": { "value": "10.20.0.0/25" },
    "domainControllerPrivateIp": { "value": "10.20.0.10" },
    "adminUsername": { "value": "labadmin" },
    "adminPassword": { "value": "" },
    "safeModeAdminPassword": { "value": "" },
    "domainName": { "value": "corp.contoso.com" },
    "domainNetbiosName": { "value": "CORP" },
    "upnSuffix": { "value": "contoso.com" },
    "labUserName": { "value": "lab.user" },
    "labUserPassword": { "value": "" },
    "entraLoginPrincipalId": { "value": "" },
    "entraPrincipalType": { "value": "Group" },
    "autoCreateEntraGroup": { "value": true },
    "intuneCredentialType": { "value": "1" },
    "mdeOnboardingBlob": { "value": "" },
    "deployBastion": { "value": true },
    "deployFirewallRules": { "value": true },
    "allowAllAzureServiceTags": { "value": true },
    "deployLinuxVms": { "value": true },
    "linuxVmSize": { "value": "Standard_D2as_v5" },
    "serverVmSize": { "value": "Standard_D2as_v5" },
    "clientVmSize": { "value": "Standard_D2as_v5" },
    "deployHydration": { "value": true },
    "autoShutdownTime": { "value": "0300" },
    "autoShutdownTimeZone": { "value": "UTC" },
    "deployDefender": { "value": true },
    "deployDefenderForServers": { "value": true },
    "deployDefenderCspm": { "value": true },
    "deployPolicy": { "value": false },
    "deployActivityLogDiagnosticSetting": { "value": true },
    "deploySentinel": { "value": true },
    "customWorkspaceName": { "value": "lab-law-lab" },
    "enableSentinelAnalytics": { "value": true },
    "deploySentinelContentScript": { "value": false },
    "enableXdrConnector": { "value": true },
    "usePrivateIngestion": { "value": false },
    "deployArcPrivateLink": { "value": true },
    "deployPrivateDnsResolver": { "value": false },
    "emailSecurityContact": { "value": "soc@contoso.com" }
  }
}
